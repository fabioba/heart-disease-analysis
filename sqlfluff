[sqlfluff]
dialect = bigquery          # ← change to: snowflake / spark / duckdb / trino
templater = dbt
max_line_length = 100
exclude_rules = RF05        # allow all-caps reserved words if your team prefers

[sqlfluff:templater:dbt]
project_dir = .             # path to dbt project root (usually repo root)

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper   # SELECT, FROM, WHERE in UPPER

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower   # column_names in lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit             # require AS in aliases
